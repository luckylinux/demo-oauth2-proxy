# Example and Guide
# https://caddyserver.com/docs/caddyfile/options

# General Options
{
    # Debug Mode
    debug

    # Explicitly forces Caddy to show cookies/auth tokens in logs
    # servers {
    #     log_credentials
    # }

    # Disable Admin API
    admin off

    # TLS Options
    # (Optional) Disable Certificates Management (only if SSL/TLS Certificates are managed by certbot or other external Tools)
    auto_https disable_certs
}

# localhost {
# 	reverse_proxy /api/* localhost:9001
# }

# Some other Application which does **NOT** require to pass through oauth2-proxy, since it has built-in OIDC Support
# Open WebUI
{$APPLICATION_HOSTNAME} {
    tls /certificates/{$APPLICATION_CERTIFICATE_DOMAIN}/{$APPLICATION_CERTIFICATE_CERT_FILE:fullchain.pem} /certificates/{$APPLICATION_CERTIFICATE_DOMAIN}/{$APPLICATION_CERTIFICATE_KEY_FILE:privkey.pem}

    log {
        output file /var/log/{$APPLICATION_HOSTNAME}/open-webui/access.json {
                roll_size 100MiB
                roll_keep 5000
                roll_keep_for 720h
                roll_uncompressed
        }

        format json
    }

    # Reverse Proxy
    reverse_proxy http://open-webui-server:{$APPLICATION_PORT}

    # Default Reverse Proxy (use IPv4 Connection)
    # reverse_proxy http://0.0.0.0:{$APPLICATION_PORT}

    # Default Reverse Proxy (use IPv6 Connection)
    # reverse_proxy http://[::1]:{$APPLICATION_PORT}
}

# Some Application which needs to go through oauth2-proxy for Authentication/Authorization
# llama.cpp Server
{$APPLICATION_HOSTNAME}:8443 {
    tls /certificates/{$APPLICATION_CERTIFICATE_DOMAIN}/{$APPLICATION_CERTIFICATE_CERT_FILE:fullchain.pem} /certificates/{$APPLICATION_CERTIFICATE_DOMAIN}/{$APPLICATION_CERTIFICATE_KEY_FILE:privkey.pem}

    log {
        output file /var/log/{$APPLICATION_HOSTNAME}/llama-cpp/access.json {
                roll_size 100MiB
                roll_keep 5000
                roll_keep_for 720h
                roll_uncompressed
        }

        format json
    }

    # Requests to /oauth2/* are proxied to oauth2-proxy without authentication.
    # You can't use `reverse_proxy /oauth2/* oauth2-proxy.internal:4180` here because the reverse_proxy directive has lower precedence than the handle directive.
    handle /oauth2/* {
        reverse_proxy oauth2-proxy:4180 {
            # Fake the Port in order to avoid Issues related to matching
            # https://github.com/oauth2-proxy/oauth2-proxy/issues/2066
            header_up Port 443
            header_up Host {host}

            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Uri {uri}

            # Allow long Requests (required if Model is not already loaded into GPU VRAM) 
            # Instruct Caddy to leave the backend socket open for streaming tokens
            transport http {
                read_timeout 600s
                dial_timeout 600s
            }
        }
    }

    # Requests to other paths are first processed by oauth2-proxy for authentication.
    handle {
        forward_auth oauth2-proxy:4180 {
            uri /oauth2

            # Fake the Port in order to avoid Issues related to matching
            # https://github.com/oauth2-proxy/oauth2-proxy/issues/2066
            header_up Port 443
            header_up Host {host}

            # CRITICAL FIX 2: Override Caddy's automatic forward_auth header generation
            header_up X-Forwarded-Host {host}

            # oauth2-proxy requires the X-Real-IP and X-Forwarded-{Proto,Host,Uri} headers.
            # The forward_auth directive automatically sets the X-Forwarded-{For,Proto,Host,Method,Uri} headers.
            header_up X-Real-IP {remote_host}

            # If needed, you can copy headers from the oauth2-proxy response to the request sent to the upstream.
            # Make sure to configure the --set-xauthrequest flag to enable this feature.
            copy_headers X-Auth-Request-User X-Auth-Request-Email Remote-User Remote-Groups Remote-Email Access-Token

            @error status 401
                handle_response @error {
                    redir * /oauth2/sign_in?rd={scheme}://{$APPLICATION_HOSTNAME}:8443{uri}
                }
            }
    }

    route {
        # Modern browsers refuse to send programmatically injected cookies back to the backend unless they comply with strict security rules.
        # If your Caddy setup does not force Secure and explicit SameSite definitions, the browser strips the cookie out of sub-resource requests.
        # The Fix: Update your cookie assignment to include standard security flags
        # request_header @extractToken +Cookie "BASIC_AUTH={http.regexp.1}; Path=/; Secure; SameSite=Lax"
        # header @extractToken +Cookie "BASIC_AUTH={re.1}; Path=/; Secure; SameSite=Lax"
        # request_header @extractToken +Cookie "BASIC_AUTH={re.auth.1}; Path=/; Secure; SameSite=Lax"

        # IPv4 Reverse Proxy
        reverse_proxy http://llama-cpp-server:9931 {
            header_up Host {host}
            header_up Port 443

            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # flush_interval -1

            # Allow long Requests (required if Model is not already loaded into GPU VRAM) 
            # Instruct Caddy to leave the backend socket open for streaming tokens
            transport http {
                read_timeout 600s
                dial_timeout 600s
            }
        }
    }
}
